# PostgreSQL
POSTGRES_PASSWORD=ledger

# Backend -- two connections, not one (README "Quick Start -- As a Library",
# Prerequisite). MIGRATE_DATABASE_URL is passed to ledger.Migrate and must be
# able to CREATE ROLE the first time (a superuser, or a CREATEROLE role that
# owns the database). DATABASE_URL is the connection every request runs
# through and must authenticate as ledger_app: several of the schema's
# guarantees (I-22, I-42, the append-only guards) are enforced by GRANT
# against that role and only that role -- a runtime connection as the
# migration superuser has none of them, silently. ledger_app's password is
# set by you after the first migration (ALTER ROLE ledger_app PASSWORD ...).
MIGRATE_DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledger?sslmode=disable
DATABASE_URL=postgres://ledger_app:change-me@localhost:5432/ledger?sslmode=disable
HTTP_PORT=8080

# Deployment environment ("dev" or "production"). Production requires
# CORS_ALLOWED_ORIGIN to be set explicitly — the service will refuse to boot
# without it to avoid shipping a wildcard CORS policy.
ENV=dev

# Comma-separated bearer-token API keys as name:scope:secret triples; scope is
# read < write < admin, optionally +deposit_review (see
# server/middleware_auth.go). When set, EVERY endpoint requires a key --
# reads included; only the probe paths and inbound webhooks are exempt. When
# empty the server logs a startup warning and serves everything
# unauthenticated; never run production that way. A malformed entry (not
# three fields) makes LoadConfig fail.
API_KEYS=ops:admin:change-me-admin,app:write:change-me-write,report:read:change-me-read

# CORS allowed origin. Use a single concrete origin in production, e.g.
# https://app.example.com. Only "dev" mode permits this to be empty (falls
# back to "*" without credentials).
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Maximum inbound request body size in bytes. Default 256 KB.
MAX_BODY_BYTES=262144

# HMAC signing key used by the EVM channel webhook adapter to verify
# inbound block-scanner callbacks. Must be at least 32 bytes of entropy in
# production.
EVM_WEBHOOK_SECRET=change-me-min-32-bytes

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
